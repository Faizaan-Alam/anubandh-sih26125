{
  "name": "anubandh",
  "private": true,
  "version": "0.1.0",
  "description": "ANUBANDH: decentralized identity, RBAC, NFT assets, attestations and audit (SIH26125)",
  "workspaces": [
    "packages/shared",
    "packages/crypto",
    "packages/policy",
    "packages/storage",
    "database",
    "backend",
    "indexer",
    "apps/web",
    "apps/verifier-pwa",
    "tests/e2e"
  ],
  "dependencies": {
    "dotenv": "^16.4.7",
    "embedded-postgres": "18.4.0-beta.17",
    "ethers": "^6.13.5",
    "tsx": "^4.19.3"
  },
  "scripts": {
    "build": "npm run build -ws --if-present",
    "test": "npm run test:contracts && npm run test -ws --if-present",
    "test:contracts": "cd contracts && forge test",
    "test:backend": "npm run test -w backend",
    "lint": "npm run lint -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "anvil": "anvil --chain-id 31337 --block-time 1",
    "deploy:anvil": "bash scripts/deploy.sh anvil",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "db:generate": "npm run generate -w database",
    "db:migrate": "npm run migrate -w database",
    "db:seed": "npm run seed -w database",
    "check:emdash": "bash scripts/check-emdash.sh",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "test:e2e": "npm run test -w @anubandh/e2e",
    "check:secrets": "bash scripts/check-secrets.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
