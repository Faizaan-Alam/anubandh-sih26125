# ANUBANDH local development environment
# Copy to .env and adjust. Never commit .env or real private keys.

# Chain
ANVIL_RPC_URL=http://127.0.0.1:8545
ANUBANDH_NETWORK=anvil
CHAIN_ID=31337

# Anvil account 0 (public well-known dev key). Admin / deployer.
# This is the first default Anvil key. It is NOT a production secret.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ADMIN_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Demo accounts (Anvil accounts 1-4). Public well-known keys for local demo only.
DEMO_MANAGER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
DEMO_MANAGER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
DEMO_AUDITOR_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
DEMO_AUDITOR_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
DEMO_USER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
DEMO_USER_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906
DEMO_USER2_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
DEMO_USER2_ADDRESS=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65

# Backend
PORT=4000
JWT_SECRET=change-me-in-any-non-local-environment
JWT_TTL_SECONDS=1800
LOGIN_NONCE_TTL_SECONDS=120
CORS_ORIGIN=http://localhost:3000
VERIFIER_ORIGIN=http://localhost:3001

# PostgreSQL (Docker Compose default). For machines without Docker, scripts/start-postgres.mjs
# starts a user-space Postgres binary on the same port.
DATABASE_URL=postgresql://anubandh:anubandh@127.0.0.1:5432/anubandh?schema=public
POSTGRES_USER=anubandh
POSTGRES_PASSWORD=anubandh
POSTGRES_DB=anubandh
POSTGRES_PORT=5432

# Object storage (local filesystem)
STORAGE_DIR=./storage-data

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Indexer
INDEXER_POLL_MS=2000
INDEXER_START_BLOCK=0
